---
import Layout from "@/layouts/Layout.astro";
import ChangePasswordForm from "@/components/auth/ChangePasswordForm";
import DeleteAccount from "@/components/auth/DeleteAccount";
import { Toaster } from "@/components/ui/sonner";

// TODO: Add middleware check - this page should be protected
// if (!Astro.locals.session) {
//   return Astro.redirect("/login");
// }

// TODO: Get user data from session
// const user = Astro.locals.session.user;
---

<Layout title="Moje konto | 10xCards">
  <main class="container mx-auto py-8 px-4">
    <div class="max-w-2xl mx-auto space-y-8">
      <div class="space-y-2">
        <h1 class="text-3xl font-bold">Moje konto</h1>
        <p class="text-muted-foreground">
          Zarządzaj ustawieniami swojego konta
        </p>
      </div>

      <div class="space-y-6">
        <ChangePasswordForm client:load />
        <DeleteAccount client:load />
      </div>
    </div>
  </main>
  <Toaster />
</Layout>

